  "type": "translation",
  "title": "Greetings & Introductions",
  "titleRussian": "Приветствия и знакомства",
  "theme": "greetings",
  "grammarFocus": ["present tense", "nominative case", "меня зовут construction"],
  "sentences": [
    {
      "id": "a1-gr-001",
      "english": "Hello!",
      "russian": "Привет!",
      "acceptableVariations": ["Здравствуйте!", "Здравствуй!"],
      "difficulty": 1,
      "hints": ["Привет is informal, Здравствуйте is formal"]
    },
    {
      "id": "a1-gr-002",
      "english": "My name is Anna.",
      "russian": "Меня зовут Анна.",
      "acceptableVariations": ["Я Анна."],
      "difficulty": 1,
      "hints": ["Use меня зовут (literally 'they call me')"]
    },
    {
      "id": "a1-gr-003",
      "english": "What is your name?",
      "russian": "Как тебя зовут?",
      "acceptableVariations": ["Как вас зовут?"],
      "difficulty": 1,
      "hints": ["тебя = informal 'you', вас = formal 'you'"]
    },
    {
      "id": "a1-gr-004",
      "english": "Nice to meet you.",
      "russian": "Очень приятно.",
      "acceptableVariations": ["Приятно познакомиться.", "Рад познакомиться.", "Рада познакомиться."],
      "difficulty": 1,
      "hints": ["Очень приятно = 'Very pleasant'"]
    },
    {
      "id": "a1-gr-005",
      "english": "Good morning!",
      "russian": "Доброе утро!",
      "acceptableVariations": [],
      "difficulty": 1,
      "hints": ["Доброе = good (neuter), утро = morning (neuter)"]
    },
    {
      "id": "a1-gr-006",
      "english": "Good evening!",
      "russian": "Добрый вечер!",
      "acceptableVariations": [],
      "difficulty": 1,
      "hints": ["Добрый = good (masculine), вечер = evening (masculine)"]
    },
    {
      "id": "a1-gr-007",
      "english": "How are you?",
      "russian": "Как дела?",
      "acceptableVariations": ["Как ты?", "Как вы?", "Как у тебя дела?", "Как у вас дела?"],
      "difficulty": 2,
      "hints": ["дела = things/affairs"]
    },
    {
      "id": "a1-gr-008",
      "english": "I am fine, thank you.",
      "russian": "Хорошо, спасибо.",
      "acceptableVariations": ["У меня всё хорошо, спасибо.", "Нормально, спасибо."],
      "difficulty": 2,
      "hints": ["Хорошо = good/fine, спасибо = thank you"]
    },
    {
      "id": "a1-gr-009",
      "english": "Goodbye!",
      "russian": "До свидания!",
      "acceptableVariations": ["Пока!", "До встречи!"],
      "difficulty": 2,
      "hints": ["До свидания = formal, Пока = informal"]
    },
    {
      "id": "a1-gr-010",
      "english": "See you tomorrow!",
      "russian": "До завтра!",
      "acceptableVariations": ["Увидимся завтра!"],
      "difficulty": 3,
      "hints": ["До = until, завтра = tomorrow"]
    }
  ]
}
