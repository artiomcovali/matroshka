      "english": "I am twenty years old.",
      "russian": "Мне двадцать лет.",
      "acceptableVariations": ["Мне 20 лет."],
      "difficulty": 1,
      "hints": ["Age uses dative: Мне + number + лет/года/год"]
    },
    {
      "id": "a1-nm-002",
      "english": "I have two brothers.",
      "russian": "У меня два брата.",
