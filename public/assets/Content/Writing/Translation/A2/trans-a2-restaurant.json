      "acceptableVariations": ["Я бы хотел заказать.", "Я бы хотела заказать."],
      "difficulty": 1,
      "hints": ["хочу = simple; бы хотел/хотела = polite conditional"]
    },
    {
      "id": "a2-rs-002",
      "english": "Can I see the menu?",
      "russian": "Можно меню?",
