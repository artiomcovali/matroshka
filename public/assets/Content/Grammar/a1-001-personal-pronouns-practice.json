              "options": [
                "он",
                "она",
                "оно",
                "они"
              ],
              "answer": "оно",
              "hint": "Neuter nouns use the neuter pronoun.",
              "explanation": "Окно is neuter (ends in -о), so the pronoun is оно."
            },
            {
              "prompt": "Собака (dog) is feminine. Which pronoun replaces it?",
              "promptEnglish": "Which pronoun replaces собака (dog)?",
              "options": [
                "он",
                "они",
                "оно",
                "она"
              ],
              "answer": "она",
              "hint": "Grammatical gender determines the pronoun.",
              "explanation": "Собака is grammatically feminine (ends in -а), so the pronoun is она, even if the dog is male."
            },
            {
              "prompt": "Вот моя сестра. _____ учится в школе.",
              "promptEnglish": "Here is my sister. _____ studies at school.",
              "options": [
                "Он",
                "Они",
                "Она",
                "Оно"
              ],
              "answer": "Она",
              "hint": "A sister is female.",
              "explanation": "Сестра (sister) is feminine, so use она (she)."
            }
          ]
        }
