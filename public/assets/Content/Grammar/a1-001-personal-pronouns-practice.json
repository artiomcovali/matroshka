{
  "lessonId": "a1-001-personal-pronouns",
  "sets": [
    {
      "id": "round-1-quiz",
      "title": "Quick Quiz",
      "titleRussian": "Быстрая викторина",
      "description": "Quiz and compare across all pronoun topics",
      "descriptionRussian": "Викторина по всем личным местоимениям",
      "icon": "questionmark.circle",
      "questions": [
        {
          "index": 0,
          "items": [
            {
              "prompt": "You're meeting a professor at university. Which 'you' do you use?",
              "promptEnglish": "You're meeting a professor at university. Which 'you' do you use?",
              "options": [
                "ты",
                "вы",
                "мы",
                "они"
              ],
              "answer": "вы",
              "hint": "Professors are addressed formally.",
              "explanation": "Use вы with professors, teachers, and anyone in a position of authority."
            },
            {
              "prompt": "Книга на столе. _____ интересная.",
              "promptEnglish": "The book is on the table. _____ is interesting.",
              "options": [
                "Он",
                "Она",
                "Оно",
                "Они"
              ],
              "answer": "Она",
              "hint": "Книга ends in -а (feminine).",
              "explanation": "Книга is feminine (ends in -а), so the pronoun is она."
            },
            {
              "prompt": "Which pronoun means 'we'?",
              "promptEnglish": "Which pronoun means 'we'?",
              "options": [
                "они",
                "вы",
                "мы",
                "я"
              ],
              "answer": "мы",
              "hint": "First person plural.",
              "explanation": "Мы means 'we'. It includes yourself plus others."
            },
            {
              "prompt": "Talking to your best friend about weekend plans. Which 'you'?",
              "promptEnglish": "Which 'you' do you use with your best friend?",
              "options": [
                "вы",
                "мы",
                "они",
                "ты"
              ],
              "answer": "ты",
              "hint": "Best friends are as close as family.",
              "explanation": "Use ты with close friends, family, and children."
            }
          ]
        }
      ],
      "minimalPairs": [
        {
          "context": "To your own grandma at home: Бабушка, _____ хорошо себя чувствуешь?",
          "contextEnglish": "To your own grandma: Do _____ feel well?",
          "options": [
            "ты",
            "вы"
          ],
          "answer": "ты",
          "explanation": "Your own grandparents are close family. Use ты with them."
        },
        {
          "context": "Извините, _____ не подскажете, где вокзал?",
          "contextEnglish": "Excuse me, could _____ tell me where the station is?",
          "options": [
            "ты",
            "вы"
          ],
          "answer": "вы",
          "explanation": "Asking a stranger for directions requires the polite вы."
        },
        {
          "context": "_____ студент. (talking about yourself)",
          "contextEnglish": "_____ am a student.",
          "options": [
            "Я",
            "Мы"
          ],
          "answer": "Я",
          "explanation": "One person talking about themselves uses я (I), not мы (we)."
        }
      ]
    },
