            {
              "prompt": "Ребята уже здесь. _____ ждут автобус.",
              "promptEnglish": "The guys are already here. _____ are waiting for the bus.",
              "options": [
                "Он",
                "Мы",
                "Они",
                "Она"
              ],
              "answer": "Они",
              "hint": "Ребята is a group of people.",
              "explanation": "Ребята (guys/kids) is plural, so use они (they)."
