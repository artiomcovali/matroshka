              "prompt": "У _____ есть велосипед. (I have a bicycle.)",
              "promptEnglish": "I have a bicycle.",
              "options": [
                "мне",
                "меня",
                "я",
                "мой"
              ],
              "answer": "меня",
              "hint": "У + genitive.",
              "explanation": "У + genitive pronoun: я → меня. У меня есть велосипед."
            },
            {
              "prompt": "У _____ есть дети. (They have children.)",
