    {
      "id": "round-1-quiz",
      "title": "Quick Quiz",
      "titleRussian": "Быстрая викторина",
      "description": "Quiz mixing pronouns, gender, and nominative case",
      "descriptionRussian": "Викторина: местоимения, род и именительный падеж",
      "icon": "questionmark.circle",
      "questions": [
        {
          "index": 0,
          "items": [
            {
              "prompt": "Машина новая. _____ стоит у дома.",
              "promptEnglish": "The car is new. _____ is parked by the house.",
              "options": [
                "Он",
                "Оно",
                "Она",
                "Они"
              ],
              "answer": "Она",
              "hint": "Машина ends in -а (feminine).",
              "explanation": "Машина is feminine (ends in -а), so the pronoun is она."
            },
            {
              "prompt": "What gender is «чашка» (cup)?",
              "promptEnglish": "What gender is «чашка» (cup)?",
              "options": [
                "masculine",
                "feminine",
                "neuter"
              ],
              "answer": "feminine",
              "hint": "Ends in -а.",
              "explanation": "Чашка ends in -а, the standard feminine ending."
            },
            {
              "prompt": "Choose the correct form: Это мой _____.",
              "promptEnglish": "This is my cat.",
              "options": [
                "кота",
                "кот",
                "коту",
                "котом"
              ],
              "answer": "кот",
              "hint": "After это, use nominative.",
              "explanation": "After это, the noun stays in nominative: кот."
            },
            {
              "prompt": "Speaking to a stranger: _____ не скажете, который час?",
              "promptEnglish": "Could _____ tell me what time it is?",
              "options": [
                "ты",
                "мы",
                "вы",
                "они"
              ],
              "answer": "вы",
              "hint": "Strangers require the formal form.",
              "explanation": "Use вы with strangers as a sign of politeness."
            }
          ]
        }
      ],
      "minimalPairs": [
        {
          "context": "_____ это? Это книга.",
          "contextEnglish": "_____ is this? This is a book.",
          "options": [
            "Что",
            "Кто"
          ],
          "answer": "Что",
          "explanation": "Книга is a thing. Use Что (What) for objects."
        },
        {
          "context": "Молоко на столе. _____ свежее.",
          "contextEnglish": "The milk is on the table. _____ is fresh.",
          "options": [
            "Он",
            "Оно"
          ],
          "answer": "Оно",
          "explanation": "Молоко is neuter (ends in -о), so the pronoun is оно."
        },
        {
          "context": "_____ пишет письмо.",
          "contextEnglish": "_____ is writing a letter.",
          "options": [
            "Брат",
            "Брата"
          ],
          "answer": "Брат",
          "explanation": "Брат is the subject (who writes). Subjects take nominative: Брат."
        },
        {
          "context": "To your younger sister: _____ хочешь мороженое?",
          "contextEnglish": "Do _____ want ice cream?",
          "options": [
            "ты",
            "вы"
          ],
          "answer": "ты",
          "explanation": "Younger siblings are family. Use the informal ты."
        }
      ]
    },
    {
