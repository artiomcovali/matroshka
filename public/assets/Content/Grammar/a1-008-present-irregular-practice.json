{
  "lessonId": "a1-008-present-irregular",
  "sets": [
    {
      "id": "round-1-quiz",
      "title": "Quick Quiz",
      "titleRussian": "Быстрая викторина",
      "description": "Pick the right form of irregular verbs",
      "descriptionRussian": "Выберите правильную форму неправильного глагола",
      "icon": "questionmark.circle",
      "questions": [
        {
          "index": 0,
          "items": [
            {
              "prompt": "Я _____ кофе. (хотеть)",
              "promptEnglish": "I want coffee.",
              "options": [
                "хочет",
                "хотим",
                "хочу",
                "хотят"
              ],
              "answer": "хочу",
              "hint": "я + хотеть.",
              "explanation": "Хотеть with я: хочу (irregular stem change хот- to хоч-)."
            },
            {
              "prompt": "Он _____ завтрак. (есть)",
              "promptEnglish": "He is eating breakfast.",
              "options": [
                "ем",
                "ешь",
                "ест",
                "едят"
              ],
              "answer": "ест",
              "hint": "он + есть (to eat).",
              "explanation": "Есть (to eat) with он: ест. Fully irregular verb."
            },
            {
              "prompt": "Мы _____ чай. (пить)",
              "promptEnglish": "We drink tea.",
              "options": [
                "пью",
                "пьёшь",
                "пьём",
                "пьют"
              ],
              "answer": "пьём",
              "hint": "мы + пить.",
              "explanation": "Пить with мы: пьём. Note the soft sign + ё pattern."
            },
            {
              "prompt": "Они _____ спать. (хотеть)",
              "promptEnglish": "They want to sleep.",
              "options": [
                "хочу",
                "хочет",
                "хотим",
                "хотят"
              ],
              "answer": "хотят",
              "hint": "они + хотеть.",
              "explanation": "Хотеть with они: хотят. The plural forms use хот- stem (like 2nd conjugation)."
            }
          ]
        }
      ],
      "minimalPairs": [
        {
          "context": "_____ ест яблоко.",
          "contextEnglish": "_____ is eating an apple.",
          "options": [
            "Он",
            "Они"
          ],
          "answer": "Он",
          "explanation": "Ест is the он/она form. The они form would be едят."
        },
        {
          "context": "Ты _____ воду? (пить)",
          "contextEnglish": "Are you drinking water?",
          "options": [
            "пьёшь",
            "пьёт"
          ],
          "answer": "пьёшь",
          "explanation": "Ты takes пьёшь. Пьёт is for он/она."
        },
        {
          "context": "Мы _____ гулять. (хотеть)",
          "contextEnglish": "We want to go for a walk.",
          "options": [
            "хотим",
            "хочет"
          ],
          "answer": "хотим",
          "explanation": "Мы takes хотим (хот- stem). Хочет (хоч- stem) is for он/она."
        },
        {
          "context": "Я _____. (I am a student.)",
          "contextEnglish": "I am a student.",
          "options": [
            "Я студент.",
            "Я есть студент."
          ],
          "answer": "Я студент.",
          "explanation": "Russian omits быть (to be) in the present tense. Just: Я студент."
        }
      ]
    },
