{
  "lessonId": "a1-011-verb-infinitive",
  "sets": [
    {
      "id": "round-1-quiz",
      "title": "Quick Quiz",
      "titleRussian": "Быстрая викторина",
      "description": "Test infinitives and modal constructions",
      "descriptionRussian": "Проверьте знание инфинитива и модальных конструкций",
      "icon": "questionmark.circle",
      "questions": [
        {
          "index": 0,
          "items": [
            {
              "prompt": "Я хочу _____ книгу. (to read)",
              "promptEnglish": "I want to read a book.",
              "options": [
                "читаю",
                "читает",
                "читать",
                "читаешь"
              ],
              "answer": "читать",
              "hint": "After хотеть, use the infinitive.",
              "explanation": "After хочу (want), use the infinitive: читать (to read)."
            },
            {
              "prompt": "_____ войти? (May I come in?)",
              "promptEnglish": "May I come in?",
              "options": [
                "Нужно",
                "Нельзя",
                "Можно",
                "Надо"
              ],
              "answer": "Можно",
              "hint": "Asking for permission.",
              "explanation": "Можно + infinitive asks permission: Можно войти? (May I enter?)"
            },
            {
              "prompt": "Здесь _____ курить. (No smoking.)",
              "promptEnglish": "Smoking is not allowed here.",
              "options": [
                "можно",
                "нужно",
                "надо",
                "нельзя"
              ],
              "answer": "нельзя",
              "hint": "Prohibition.",
              "explanation": "Нельзя + infinitive = prohibition: Нельзя курить."
            },
            {
              "prompt": "What is the most common infinitive ending?",
              "promptEnglish": "What do most Russian infinitives end in?",
              "options": [
                "-ет",
                "-чь",
                "-ть",
                "-ти"
              ],
              "answer": "-ть",
              "hint": "читать, говорить, работать.",
              "explanation": "Most infinitives end in -ть: читать, говорить, работать."
            }
          ]
        }
      ],
      "minimalPairs": [
        {
          "context": "_____ здесь фотографировать? (asking permission)",
          "contextEnglish": "May I photograph here?",
          "options": [
            "Можно",
            "Нельзя"
          ],
          "answer": "Можно",
          "explanation": "Можно asks permission. Нельзя states prohibition."
        },
        {
          "context": "Здесь _____ парковаться. (prohibition)",
          "contextEnglish": "Parking is not allowed here.",
          "options": [
            "можно",
            "нельзя"
          ],
          "answer": "нельзя",
          "explanation": "Нельзя = prohibition. Можно = permission."
        },
        {
          "context": "Мне _____ работать. (I need to work.)",
          "contextEnglish": "I need to work.",
          "options": [
            "нужно",
            "можно"
          ],
          "answer": "нужно",
          "explanation": "Нужно = necessity (need to). Можно = permission (may)."
        },
        {
          "context": "Я хочу _____. (to eat)",
          "contextEnglish": "I want to eat.",
          "options": [
            "есть",
            "ем"
          ],
          "answer": "есть",
          "explanation": "After хочу, use the infinitive: есть (to eat). Ем is the conjugated я form."
        }
      ]
    },
