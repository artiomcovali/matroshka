                "говоришь"
              ],
              "answer": "говорим",
              "hint": "мы = first person plural, 2nd conjugation.",
              "explanation": "Говорить is 2nd conjugation. With мы, add -им: говорим."
            },
            {
              "prompt": "Ты _____ газету. (читать)",
              "promptEnglish": "You read a newspaper.",
              "options": [
                "читаю",
                "читает",
                "читаешь",
                "читают"
              ],
              "answer": "читаешь",
              "hint": "ты = second person singular, 1st conjugation.",
              "explanation": "Читать is 1st conjugation. With ты, add -ешь: читаешь."
            },
            {
              "prompt": "Они _____ телевизор. (смотреть)",
              "promptEnglish": "They watch TV.",
              "options": [
                "смотрю",
                "смотрит",
                "смотрят",
                "смотрим"
              ],
              "answer": "смотрят",
              "hint": "они = third person plural, 2nd conjugation.",
              "explanation": "Смотреть is 2nd conjugation. With они, add -ят: смотрят."
            }
          ]
        }
