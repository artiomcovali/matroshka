  "questions": [
    {
      "index": 0,
      "items": [
        {
          "prompt": "Я вижу _____. (I see the brother.)",
          "promptEnglish": "I see the brother.",
          "options": [
            "брату",
            "братом",
            "брата",
            "брат"
          ],
          "answer": "брата",
          "hint": "Direct object = accusative (animate masculine)",
          "explanation": "Видеть takes accusative; animate masculine: брат → брата."
        },
        {
          "prompt": "Это книга _____. (This is the teacher's book.)",
          "promptEnglish": "This is the teacher's book.",
          "options": [
            "учитель",
            "учителем",
            "учителя",
            "учителю"
          ],
          "answer": "учителя",
          "hint": "Possession = genitive",
          "explanation": "Possession uses genitive: учитель → учителя."
        },
        {
          "prompt": "_____ читает газету. (The student reads the newspaper.)",
          "promptEnglish": "The student reads the newspaper.",
          "options": [
            "Студентом",
            "Студент",
            "Студенту",
            "Студента"
          ],
          "answer": "Студент",
          "hint": "Subject = nominative",
          "explanation": "The subject uses nominative case."
        }
      ]
    },
    {
      "index": 1,
      "items": [
        {
          "prompt": "Я звоню _____. (I'm calling my friend.)",
          "promptEnglish": "I'm calling my friend.",
          "options": [
            "друг",
            "другом",
            "другу",
            "друга"
          ],
          "answer": "другу",
          "hint": "Звонить + dative",
          "explanation": "Звонить takes dative: друг → другу."
        },
        {
          "prompt": "Она пишет _____. (She writes with a pen.)",
          "promptEnglish": "She writes with a pen.",
          "options": [
            "ручку",
            "ручке",
            "ручка",
            "ручкой"
          ],
          "answer": "ручкой",
          "hint": "Instrument = instrumental",
          "explanation": "Writing instrument uses instrumental: ручка → ручкой."
        },
        {
          "prompt": "Мы говорим о _____. (We're talking about the book.)",
          "promptEnglish": "We're talking about the book.",
          "options": [
            "книги",
            "книгу",
            "книга",
            "книге"
          ],
          "answer": "книге",
          "hint": "О + prepositional",
          "explanation": "О (about) takes prepositional: книга → книге."
        }
      ]
    },
    {
      "index": 2,
      "items": [
        {
          "prompt": "У меня нет _____. (I don't have time.)",
