    {
      "id": "round-1-quiz",
      "title": "Quick Quiz",
      "titleRussian": "Быстрая викторина",
      "description": "Pick the right question word for each situation",
      "descriptionRussian": "Выберите правильное вопросительное слово",
      "icon": "questionmark.circle",
      "questions": [
        {
          "index": 0,
          "items": [
            {
              "prompt": "_____ это? — Это мой друг. (asking about a person)",
              "promptEnglish": "_____ is this? This is my friend.",
              "options": [
                "Где",
                "Кто",
                "Когда",
                "Что"
              ],
              "answer": "Кто",
              "hint": "Asking about a person.",
              "explanation": "Кто (Who) is used when asking about people."
            },
            {
              "prompt": "_____ ты живёшь? — В Москве.",
              "promptEnglish": "_____ do you live? In Moscow.",
              "options": [
                "Когда",
                "Куда",
                "Где",
                "Откуда"
              ],
              "answer": "Где",
              "hint": "Asking about location, not direction.",
              "explanation": "Где (Where) asks about current location. The answer uses в + prepositional."
            },
            {
              "prompt": "_____ ты идёшь? — В магазин.",
              "promptEnglish": "_____ are you going? To the store.",
              "options": [
                "Что",
                "Откуда",
                "Где",
                "Куда"
              ],
              "answer": "Куда",
              "hint": "Asking about destination.",
              "explanation": "Куда (Where to) asks about direction or destination."
            },
            {
              "prompt": "_____ ты не пришёл? — Я был болен.",
              "promptEnglish": "_____ didn't you come? I was sick.",
              "options": [
                "Где",
                "Когда",
                "Как",
                "Почему"
              ],
              "answer": "Почему",
              "hint": "Asking for a reason.",
              "explanation": "Почему (Why) asks about the reason for something."
            }
          ]
        }
      ],
      "minimalPairs": [
        {
          "context": "_____ ты? — В школе.",
          "contextEnglish": "_____ are you? At school.",
          "options": [
            "Где",
            "Куда"
          ],
          "answer": "Где",
          "explanation": "Где asks about current location. Куда asks about direction/destination."
        },
        {
          "context": "_____ ты идёшь? — В школу.",
          "contextEnglish": "_____ are you going? To school.",
          "options": [
            "Куда",
            "Где"
          ],
          "answer": "Куда",
          "explanation": "Куда asks about direction/destination. Где asks about location."
        },
        {
          "context": "_____ это на столе? — Это книга.",
          "contextEnglish": "_____ is this on the table? It's a book.",
          "options": [
            "Кто",
            "Что"
          ],
          "answer": "Что",
          "explanation": "Книга is a thing. Use Что (What) for objects."
        },
        {
          "context": "_____ ты приехал? — Из Петербурга.",
          "contextEnglish": "_____ did you come? From Petersburg.",
          "options": [
            "Где",
            "Откуда"
          ],
          "answer": "Откуда",
          "explanation": "Откуда (Where from) asks about origin. Из + genitive in the answer."
        }
      ]
    },
