    {
      "id": "round-1-quiz",
      "title": "Quick Quiz",
      "titleRussian": "Быстрая викторина",
      "description": "Quiz mixing word order, conjugation, negation, infinitives, and numbers",
      "descriptionRussian": "Викторина: порядок слов, спряжение, отрицание, инфинитив и числа",
      "icon": "questionmark.circle",
      "questions": [
        {
          "index": 0,
          "items": [
            {
              "prompt": "Я _____ книгу. (читать)",
              "promptEnglish": "I am reading a book.",
              "options": [
                "читать",
                "читаешь",
                "читает",
                "читаю"
              ],
              "answer": "читаю",
              "hint": "я + 1st conjugation present tense.",
              "explanation": "Читать with я: читаю. 1st conjugation, -ю ending for я."
            },
            {
              "prompt": "Она _____ работает сегодня.",
              "promptEnglish": "She doesn't work today.",
              "options": [
                "нет",
                "ни",
                "не",
                "но"
              ],
              "answer": "не",
              "hint": "Negation particle before the verb.",
              "explanation": "Не is placed directly before the verb to negate: не работает."
            },
            {
              "prompt": "What is 30 in Russian?",
              "promptEnglish": "What is 30 in Russian?",
              "options": [
                "двадцать",
                "тринадцать",
                "тридцать",
                "сорок"
              ],
              "answer": "тридцать",
              "hint": "три + дцать.",
              "explanation": "Тридцать (30) = три (3) + дцать (tens suffix for 20-30)."
            },
            {
              "prompt": "Мы хотим _____ в парк. (to go)",
              "promptEnglish": "We want to go to the park.",
              "options": [
                "идём",
                "идёшь",
                "идти",
                "идёт"
              ],
              "answer": "идти",
              "hint": "After хотеть, use the infinitive.",
              "explanation": "After хотим (want), use the infinitive: идти (to go)."
            }
          ]
        }
      ],
      "minimalPairs": [
        {
          "context": "Я _____ книгу.",
          "contextEnglish": "Which is the present tense (not infinitive)?",
          "options": [
            "читаю",
            "читать"
          ],
          "answer": "читаю",
          "explanation": "Читаю is conjugated present tense (I read). Читать is the infinitive (to read)."
        },
        {
          "context": "Он _____ работает. (negation)",
          "contextEnglish": "He doesn't work.",
          "options": [
            "не",
            "нет"
          ],
          "answer": "не",
          "explanation": "Не goes before verbs for negation. Нет is a standalone 'no' or means 'there is no.'"
        },
        {
          "context": "Which sentence is neutral SVO?",
          "contextEnglish": "Which is the neutral word order?",
          "options": [
            "Мама читает книгу.",
            "Книгу читает мама."
          ],
          "answer": "Мама читает книгу.",
          "explanation": "SVO (Subject-Verb-Object) is neutral. The second sentence changes order for emphasis."
        },
        {
          "context": "Я хочу _____ книгу.",
          "contextEnglish": "I want to read a book.",
          "options": [
            "читать",
            "читаю"
          ],
          "answer": "читать",
          "explanation": "After хочу, use the infinitive: читать (to read), not the conjugated form."
        }
      ]
    },
