          "index": 0,
          "items": [
            {
              "prompt": "_____ дом очень старый. (This, masculine)",
              "promptEnglish": "This house is very old.",
              "options": [
                "Эта",
                "Это",
                "Этот",
                "Эти"
              ],
              "answer": "Этот",
              "hint": "Дом is masculine.",
              "explanation": "Дом is masculine: этот дом."
            },
            {
              "prompt": "Я читаю _____. (book, accusative)",
              "promptEnglish": "I am reading a book.",
              "options": [
                "книга",
                "книге",
                "книгу",
                "книги"
              ],
              "answer": "книгу",
              "hint": "Feminine -а becomes -у in accusative.",
              "explanation": "Читать + accusative: книга -> книгу."
            },
            {
              "prompt": "Он живёт в _____. (city, prepositional)",
              "promptEnglish": "He lives in the city.",
              "options": [
                "город",
                "города",
                "городу",
                "городе"
              ],
              "answer": "городе",
              "hint": "В + prepositional: add -е.",
              "explanation": "В + prepositional case: город -> городе."
            },
            {
              "prompt": "Она работает _____ заводе. (at the factory)",
              "promptEnglish": "She works at the factory.",
              "options": [
                "в",
                "на",
                "о",
                "у"
              ],
              "answer": "на",
              "hint": "Завод uses на (not в) for 'at.'",
              "explanation": "На заводе (factory uses на, not в)."
            }
          ]
        }
      ],
      "minimalPairs": [
        {
          "context": "Я вижу _____. (table, accusative, masculine inanimate)",
          "contextEnglish": "I see a table.",
          "options": [
            "стол",
            "стола"
          ],
          "answer": "стол",
          "explanation": "Masculine inanimate nouns don't change in accusative: стол stays стол."
        },
        {
          "context": "Я вижу _____. (cat, accusative, masculine animate)",
          "contextEnglish": "I see a cat.",
          "options": [
            "кот",
            "кота"
          ],
          "answer": "кота",
          "explanation": "Masculine animate nouns take genitive-like form in accusative: кот -> кота."
        },
        {
          "context": "Книга лежит _____ столе. (on the table)",
          "contextEnglish": "The book is on the table.",
          "options": [
            "в",
            "на"
          ],
          "answer": "на",
          "explanation": "На столе (on the table). На = on a surface."
        },
        {
          "context": "Он сидит _____ комнате. (in the room)",
          "contextEnglish": "He is sitting in the room.",
          "options": [
            "в",
            "на"
          ],
          "answer": "в",
          "explanation": "В комнате (in the room). В = inside an enclosed space."
        }
      ]
