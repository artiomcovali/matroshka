      "questions": [
        {
          "index": 0,
          "items": [
            {
              "prompt": "Это _____. (a cat)",
              "promptEnglish": "This is a cat.",
              "options": [
                "кошка",
                "кошку",
                "кошке",
                "кошкой"
              ],
              "answer": "кошка",
              "hint": "After это, use the dictionary form.",
              "explanation": "After это, the noun stays in nominative (dictionary form): кошка."
            },
            {
              "prompt": "«Учитель читает книгу.» Which word is the subject?",
              "promptEnglish": "The teacher is reading a book. Which word is the subject?",
              "options": [
                "книгу",
                "читает",
                "учитель"
              ],
              "answer": "учитель",
              "hint": "Who is doing the reading?",
              "explanation": "Учитель (teacher) is doing the reading, so it's the subject in nominative case."
            },
            {
              "prompt": "_____ это? Это телефон.",
              "promptEnglish": "_____ is this? This is a phone.",
              "options": [
                "Кто",
                "Что",
                "Где",
                "Как"
              ],
              "answer": "Что",
              "hint": "A phone is a thing, not a person.",
              "explanation": "Телефон is an object, so use Что (What), not Кто (Who)."
            },
            {
              "prompt": "Choose the correct form: _____ спит на диване.",
              "promptEnglish": "_____ is sleeping on the sofa.",
              "options": [
                "Кошку",
                "Кошке",
                "Кошка",
                "Кошкой"
              ],
              "answer": "Кошка",
              "hint": "Who is sleeping? That word is the subject.",
              "explanation": "Кошка is the subject (who is sleeping), so it stays in nominative."
            }
          ]
        }
      ],
      "minimalPairs": [
