      "text": "—",
      "start": 55.728,
      "end": 55.774
    },
    {
      "text": "напишите.»",
      "start": 55.844,
      "end": 56.68
    },
    {
      "text": "Я",
      "start": 57.632,
      "end": 57.748
    },
    {
      "text": "смотрел",
      "start": 57.864,
      "end": 58.317
    },
    {
      "text": "на",
      "start": 58.375,
      "end": 58.433
    },
    {
      "text": "визитку.",
      "start": 58.479,
      "end": 59.164
    },
    {
      "text": "Может",
      "start": 59.315,
      "end": 59.675
    },
    {
      "text": "быть,",
      "start": 59.733,
      "end": 59.954
    },
    {
      "text": "заблудиться",
      "start": 59.989,
      "end": 60.534
    },
    {
      "text": "было",
      "start": 60.604,
      "end": 60.883
    },
    {
      "text": "не",
      "start": 60.917,
      "end": 60.999
    },
    {
      "text": "так",
      "start": 61.057,
      "end": 61.231
    },
    {
      "text": "уж",
      "start": 61.312,
      "end": 61.382
    },
    {
      "text": "плохо.",
      "start": 61.451,
      "end": 61.974
    },
    {
      "text": "Иногда",
      "start": 62.253,
      "end": 62.787
    },
    {
      "text": "судьба",
      "start": 62.868,
      "end": 63.205
    },
    {
      "text": "знает,",
      "start": 63.263,
      "end": 63.623
    },
    {
      "text": "что",
      "start": 63.657,
      "end": 63.832
    },
    {
      "text": "делает.",
      "start": 63.89,
      "end": 64.644
    }
