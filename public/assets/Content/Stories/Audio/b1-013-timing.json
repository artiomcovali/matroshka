      "end": 14.791
    },
    {
      "text": "не",
      "start": 14.942,
      "end": 15.058
    },
    {
      "text": "останавливается.",
      "start": 15.093,
      "end": 16.045
    },
    {
      "text": "Я",
      "start": 16.289,
      "end": 16.382
    },
    {
      "text": "подошёл",
