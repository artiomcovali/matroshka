      "end": 1.312
    },
    {
      "text": "самый",
      "start": 1.382,
      "end": 1.718
    },
    {
      "text": "неподходящий",
      "start": 1.753,
      "end": 2.461
    },
    {
      "text": "момент.",
      "start": 2.519,
      "end": 3.007
    },
    {
