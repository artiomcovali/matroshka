      "text": "на",
      "start": 21.572,
      "end": 21.63
    },
    {
      "text": "меня",
      "start": 21.676,
      "end": 21.943
    },
    {
      "text": "и",
      "start": 22.036,
      "end": 22.094
    },
    {
      "text": "улыбнулась.",
      "start": 22.152,
      "end": 22.837
    },
    {
      "text": "«Какой",
      "start": 22.988,
      "end": 23.371
    },
    {
      "text": "станции?",
