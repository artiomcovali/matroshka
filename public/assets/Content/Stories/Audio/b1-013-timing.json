      "start": 17.531,
      "end": 18.205
    },
    {
      "text": "«Извините,",
      "start": 18.379,
      "end": 19.087
    },
    {
      "text": "как",
      "start": 19.11,
      "end": 19.25
    },
    {
      "text": "пройти",
      "start": 19.308,
      "end": 19.563
    },
    {
      "text": "к",
      "start": 19.586,
      "end": 19.621
    },
    {
      "text": "станции",
      "start": 19.656,
      "end": 20.039
    },
    {
      "text": "метро?»",
      "start": 20.086,
      "end": 20.562
    },
    {
      "text": "Она",
      "start": 20.771,
      "end": 20.991
    },
    {
      "text": "посмотрела",
      "start": 21.038,
      "end": 21.537
    },
