      "end": 23.963
    },
    {
      "text": "Их",
      "start": 24.056,
      "end": 24.219
    },
    {
      "text": "тут",
      "start": 24.277,
      "end": 24.393
    },
    {
      "text": "несколько.»",
      "start": 24.451,
      "end": 25.066
    },
    {
      "text": "Я",
      "start": 25.31,
      "end": 25.391
    },
    {
      "text": "растерялся.",
      "start": 25.473,
      "end": 26.169
    },
    {
      "text": "«Не",
      "start": 26.32,
      "end": 26.564
    },
    {
      "text": "знаю...",
      "start": 26.61,
      "end": 27.028
    },
    {
      "text": "Любой.»",
      "start": 27.144,
      "end": 27.783
    },
    {
      "text": "Она",
      "start": 27.957,
      "end": 28.189
    },
    {
      "text": "засмеялась.",
      "start": 28.259,
      "end": 29.002
    },
    {
      "text": "«Вы",
      "start": 29.153,
      "end": 29.443
    },
    {
      "text": "явно",
      "start": 29.513,
      "end": 29.803
    },
    {
      "text": "не",
      "start": 29.838,
      "end": 29.896
    },
    {
      "text": "москвич.",
      "start": 29.954,
      "end": 30.546
    },
    {
      "text": "Идите",
      "start": 30.662,
      "end": 31.034
    },
    {
      "text": "прямо,",
      "start": 31.092,
      "end": 31.498
    },
    {
      "text": "потом",
      "start": 31.521,
      "end": 31.765
    },
    {
      "text": "поверните",
      "start": 31.812,
      "end": 32.276
    },
    {
      "text": "направо,",
      "start": 32.323,
      "end": 32.833
    },
    {
      "text": "пройдите",
      "start": 32.868,
      "end": 33.391
    },
    {
      "text": "мимо",
      "start": 33.425,
      "end": 33.634
    },
    {
      "text": "ГУМа,",
      "start": 33.693,
      "end": 34.122
    },
    {
      "text": "и",
      "start": 34.215,
      "end": 34.285
    },
    {
      "text": "там",
      "start": 34.366,
      "end": 34.517
    },
    {
      "text": "сможете",
      "start": 34.575,
      "end": 34.935
    },
    {
      "text": "выйти",
      "start": 34.981,
      "end": 35.202
    },
    {
      "text": "к",
      "start": 35.237,
      "end": 35.26
    },
    {
      "text": "метро.»",
      "start": 35.318,
      "end": 35.817
    },
    {
      "text": "Я",
      "start": 36.026,
      "end": 36.107
    },
    {
      "text": "повторил:",
      "start": 36.2,
      "end": 36.688
    },
    {
      "text": "«Прямо,",
      "start": 36.781,
      "end": 37.443
    },
    {
      "text": "направо,",
      "start": 37.512,
      "end": 38.186
    },
    {
      "text": "мимо",
      "start": 38.232,
      "end": 38.499
    },
    {
      "text": "ГУМа...»",
      "start": 38.557,
      "end": 39.045
    },
    {
      "text": "«Знаете",
      "start": 39.428,
      "end": 39.974
    },
    {
      "text": "что,",
      "start": 40.055,
      "end": 40.473
    },
    {
      "text": "я",
      "start": 40.554,
      "end": 40.624
    },
    {
      "text": "тоже",
      "start": 40.705,
      "end": 40.937
    },
    {
      "text": "туда",
      "start": 40.972,
      "end": 41.169
    },
    {
      "text": "иду.",
      "start": 41.216,
      "end": 41.552
    },
    {
      "text": "Пойдёмте",
      "start": 41.878,
      "end": 42.4
    },
    {
      "text": "вместе.»",
      "start": 42.435,
      "end": 43.015
    },
    {
      "text": "Мы",
      "start": 43.34,
      "end": 43.48
    },
    {
      "text": "шли",
      "start": 43.538,
      "end": 43.84
    },
    {
      "text": "и",
      "start": 43.933,
      "end": 43.979
    },
    {
      "text": "разговаривали.",
      "start": 44.06,
      "end": 44.873
    },
    {
      "text": "Её",
      "start": 45.117,
      "end": 45.279
    },
    {
      "text": "зовут",
      "start": 45.337,
      "end": 45.558
    },
    {
      "text": "Катя.",
      "start": 45.628,
      "end": 46.033
    },
    {
      "text": "Она",
      "start": 46.184,
      "end": 46.405
    },
    {
      "text": "студентка-медик.",
      "start": 46.451,
      "end": 47.496
    },
    {
      "text": "Живёт",
      "start": 47.612,
      "end": 47.949
    },
    {
      "text": "в",
      "start": 47.972,
      "end": 47.996
    },
    {
      "text": "Москве",
      "start": 48.019,
      "end": 48.39
    },
    {
      "text": "третий",
      "start": 48.448,
      "end": 48.797
    },
    {
      "text": "год.",
      "start": 48.866,
      "end": 49.284
    },
    {
      "text": "«Телефон",
      "start": 49.609,
      "end": 50.155
    },
    {
      "text": "заряжать",
      "start": 50.213,
      "end": 50.654
    },
    {
      "text": "надо,»",
      "start": 50.712,
      "end": 50.991
    },
    {
      "text": "—",
      "start": 51.107,
      "end": 51.211
    },
    {
      "text": "сказала",
      "start": 51.328,
      "end": 51.815
    },
