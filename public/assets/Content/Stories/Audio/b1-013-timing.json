      "end": 9.358
    },
    {
      "text": "карты.",
      "start": 9.427,
      "end": 9.927
    },
    {
      "text": "Вокруг",
      "start": 10.077,
      "end": 10.553
    },
    {
      "text": "—",
      "start": 10.612,
      "end": 10.681
    },
    {
      "text": "туристы,",
      "start": 10.728,
      "end": 11.355
    },
    {
      "text": "продавцы",
      "start": 11.401,
      "end": 11.9
    },
    {
