      "text": "она",
      "start": 51.896,
      "end": 52.198
    },
    {
      "text": "у",
      "start": 52.291,
      "end": 52.349
    },
    {
      "text": "метро.",
      "start": 52.396,
      "end": 52.941
    },
    {
      "text": "«Вот",
      "start": 53.116,
      "end": 53.487
    },
    {
      "text": "моя",
      "start": 53.557,
      "end": 53.708
    },
    {
      "text": "визитка.",
      "start": 53.754,
      "end": 54.358
    },
    {
      "text": "Если",
      "start": 54.532,
      "end": 54.811
    },
    {
      "text": "опять",
      "start": 54.845,
      "end": 55.089
    },
    {
      "text": "заблудитесь",
      "start": 55.124,
      "end": 55.705
    },
