      "end": 5.747
    },
    {
      "text": "понятия",
      "start": 5.817,
      "end": 6.258
    },
    {
      "text": "не",
      "start": 6.316,
      "end": 6.432
    },
    {
      "text": "имел,",
      "start": 6.467,
      "end": 6.803
    },
    {
      "text": "куда",
      "start": 6.827,
      "end": 7.256
    },
    {
      "text": "идти.",
      "start": 7.372,
      "end": 7.941
    },
    {
      "text": "Ни",
